<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">
    <Grid ColumnDefinitions="Auto,Auto">
        <CollectionView Grid.Column="0" x:Name="MygamesList">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Label Text="{Binding .}" FontSize="20" FontFamily="ZenzaiItacha"/>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        </CollectionView>
        <CollectionView Grid.Column="1" x:Name="MygamesPlaytimeList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" FontSize="20" FontFamily="ZenzaiItacha"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
